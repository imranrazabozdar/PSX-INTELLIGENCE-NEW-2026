# Optional server deployment
PSX_DB=psx_v2.db
# Add an LLM key only when you intentionally deploy a grounded server-side summarizer.
# Never embed private API keys in the Android APK.
LLM_PROVIDER=
LLM_API_KEY=

# Document vault root for manually ingested PDFs (see docs/DOCUMENT_VAULT.md).
# Any local path outside the git checkout; never committed.
DOCUMENT_VAULT_PATH=/path/to/psx_document_vault
